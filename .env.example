# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Flask secret key for sessions (generate a random key)
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secret_key_here

# Company email domain
ALLOWED_EMAIL_DOMAIN=thejungletechnology.com

# --- Result email delivery (Gmail API) ---
# Mailbox (or alias of the consenting mailbox) that emails are sent "from".
GMAIL_SENDER=noreply@thejungletechnology.com
# Optional: monitored mailbox to receive replies (set as Reply-To). Leave blank for none.
GMAIL_REPLY_TO=

# Option B (active, no Workspace admin): OAuth refresh token for the sender
# mailbox. Generate once with: python get_gmail_token.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Option A (fallback, needs Workspace admin): keyless domain-wide delegation.
# Leave blank if using Option B above.
# MAILER_SA=appads-mailer@your-project.iam.gserviceaccount.com

# --- Optional tuning ---
# Path to prefetched bundle->URL metadata and the runtime checkpoint cache.
METADATA_CSV=metadata.csv
CHECKPOINT_FILE=checkpoint.csv
MAX_DISCOVERY_ATTEMPTS=5
# Gzip the result attachment above this many bytes (default 17 MB).
GZIP_THRESHOLD_BYTES=17825792
